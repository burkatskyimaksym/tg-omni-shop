STORE_NAME="Omni Shop"
STORE_DESCRIPTION="Your one-stop store"

# WordPress Environment
# Set to 'false' in production
WORDPRESS_DEBUG=true

# Database Credentials
# Make sure to change these before deployment
MARIADB_ROOT_PASSWORD=your_secure_root_password
MARIADB_DATABASE=omni_shop
MARIADB_USER=wp_user
MARIADB_PASSWORD=your_secure_user_password

# WatForPay Credentials
WAY_FOR_PAY_MERCHANT_ACCOUNT=test_merch_n1
WAY_FOR_PAY_MERCHANT_SECRET_KEY=flk3409refn54t54t*FNJRET

# Telegram Bot
BOT_TOKEN=your_bot_token_from_botfather

# LLM Provider (ollama | openrouter)
LLM_PROVIDER=ollama
LLM_MODEL=llama3:8b

# Ollama (local)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Memory
MEMORY_MAX_RAW_MESSAGES=10
MEMORY_SUMMARIZE_THRESHOLD=20